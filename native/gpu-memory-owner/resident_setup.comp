#version 450
// Setup/stream kernel for the isolated device-resident bandwidth benchmark.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) buffer Reference0 { uint a0[]; };
layout(set=0,binding=1,std430) buffer Reference1 { uint a1[]; };
layout(set=0,binding=2,std430) buffer Reference2 { uint a2[]; };
layout(set=0,binding=3,std430) buffer Reference3 { uint a3[]; };
layout(set=0,binding=4,std430) buffer IO { uint io[]; };
layout(push_constant) uniform Parameters { uint mode; uint count; uint segment_words; uint object_words; } p;
uint mix(uint value) {
    value ^= value >> 16; value *= 0x7feb352du;
    value ^= value >> 15; value *= 0x846ca68bu;
    return value ^ (value >> 16);
}
void main() {
    uint i=gl_GlobalInvocationID.x + gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*256u);
    if(i>=p.count) return;
    uint segment=i/p.segment_words, offset=i%p.segment_words;
    if(p.mode==0u) {
        uint value=(i*2654435761u)^0x5a5aa5a5u;
        if(segment==0u) a0[offset]=value;
        else if(segment==1u) a1[offset]=value;
        else if(segment==2u) a2[offset]=value;
        else if(segment==3u) a3[offset]=value;
    } else if(p.mode==1u || p.mode==2u) {
        io[i]=p.mode==1u ? i%p.object_words : mix(i+1u)%p.object_words;
        io[p.count+i]=0u;
    } else {
        uint value=0u;
        if(segment==0u) value=a0[offset];
        else if(segment==1u) value=a1[offset];
        else if(segment==2u) value=a2[offset];
        else if(segment==3u) value=a3[offset];
        io[i]=value;
    }
}
