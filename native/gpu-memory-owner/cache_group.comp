#version 450
// GPU bucket grouping: reference regions are 1 MiB for the 256 MiB probe.
// Retain original positions so callers receive results in request order.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer R0 { uint a0[]; };
layout(set=0,binding=1,std430) readonly buffer R1 { uint a1[]; };
layout(set=0,binding=2,std430) readonly buffer R2 { uint a2[]; };
layout(set=0,binding=3,std430) readonly buffer R3 { uint a3[]; };
layout(set=0,binding=4,std430) buffer IO { uint io[]; };
layout(push_constant) uniform P { uint count; uint segment_words; uint mode; uint object_words; } p;
uint bucket(uint index) { return min(index/max(p.object_words/256u,1u),255u); }
void main() {
 uint i=gl_GlobalInvocationID.x, counters=5u*p.count, offsets=counters+256u;
 if(p.mode==1u) {
  if(i!=0u)return;
  uint sum=0u;
  for(uint b=0u;b<256u;++b) { uint n=io[counters+b];io[offsets+b]=sum;sum+=n; }
  return;
 }
 if(i>=p.count)return;
 if(p.mode==0u) { atomicAdd(io[counters+bucket(io[i])],1u);return; }
 if(p.mode==2u) {
  uint index=io[i], dst=atomicAdd(io[offsets+bucket(index)],1u);
  io[2u*p.count+dst]=index;io[3u*p.count+i]=dst;return;
 }
 if(p.mode==4u) { io[p.count+i]=io[4u*p.count+io[3u*p.count+i]];return; }
 uint index=io[2u*p.count+i], value=0u;
 if(index<p.object_words) {
  uint segment=index/p.segment_words, offset=index%p.segment_words;
  if(segment==0u)value=a0[offset];else if(segment==1u)value=a1[offset];
  else if(segment==2u)value=a2[offset];else if(segment==3u)value=a3[offset];
 }
 io[4u*p.count+i]=value;
}
