FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client gzip docker-cli iproute2 git ca-certificates openssl && rm -rf /var/lib/apt/lists/*
# Application code is supplied by the host checkout, never baked into this image.
COPY requirements-node.txt /tmp/requirements-node.txt
RUN pip install --no-cache-dir -r /tmp/requirements-node.txt && rm /tmp/requirements-node.txt
HEALTHCHECK --interval=10s --timeout=3s --start-period=10m CMD python -c "from pathlib import Path; raise SystemExit(not Path('/tmp/launcher-ready').exists())"
RUN ln -s /opt/swarm-node/scripts/swarm_node.py /usr/local/bin/swarm-node && printf '#!/bin/sh\nexec python -m ramtop "$@"\n' > /usr/local/bin/ramtop && chmod +x /usr/local/bin/ramtop
ENV SWARM_WORKSPACE=/opt/swarm-node
ENV PYTHONPATH=/opt/swarm-node:/opt/swarm-node/JSwarm/ramtop
